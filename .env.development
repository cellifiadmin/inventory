# Development Environment Variables
# Used when deploying with: serverless deploy --stage development
# SECURITY: do not commit real secrets in this file. Use AWS Secrets Manager / deployment env injection.

# OIDC Configuration
OIDC_REALM=/cellifi/dev/inventory/runtime/oidc-realm

# Inventory Database
DATABASE_URL=/aws/reference/secretsmanager/cellifi/dev/inventory/runtime:database_url
INVENTORY_DATABASE_URL=/aws/reference/secretsmanager/cellifi/dev/inventory/runtime:database_url

# AWS Configuration
PRIVATE_BUCKET_NAME=/cellifi/dev/inventory/runtime/private-bucket-name
OFFERS_STOCK_SYNC_QUEUE_URL=/cellifi/dev/inventory/runtime/offers-stock-sync-queue-url
OFFERS_STOCK_SYNC_QUEUE_ARN=/cellifi/dev/inventory/runtime/offers-stock-sync-queue-arn

# Inventory Redis
CACHE_REDIS_URL=/aws/reference/secretsmanager/cellifi/dev/inventory/runtime:cache_redis_url
CACHE_REDIS_KEY_PREFIX=/aws/reference/secretsmanager/cellifi/dev/inventory/runtime:cache_redis_key_prefix
SERVICE_ENCRYPTION_KEY=/aws/reference/secretsmanager/cellifi/dev/inventory/runtime:service_encryption_key
GOOGLE_MAPS_API_KEY=/aws/reference/secretsmanager/cellifi/dev/inventory/runtime:google_maps_api_key

CELLIFI_AWS_REGION=/cellifi/dev/inventory/runtime/aws-region
S3_ENDPOINT=
OBJECT_STORAGE_PUBLIC_BASE_URL=
INVENTORY_AWS_ENDPOINT_URL=
CELLIFI_AWS_ACCESS_KEY_ID=
CELLIFI_AWS_SECRET_ACCESS_KEY=
CLOUDFRONT_DOMAIN=/cellifi/dev/inventory/runtime/cloudfront-domain
MP_FE_URL=/cellifi/dev/inventory/runtime/mp-fe-url

AUTH_SHARED_AUTHORIZER_ARN=/cellifi/dev/inventory/runtime/auth-shared-authorizer-arn
COMMERCE_COMMAND_QUEUE_URL=/cellifi/dev/inventory/runtime/commerce-command-queue-url
COMMERCE_COMMAND_QUEUE_ARN=/cellifi/dev/inventory/runtime/commerce-command-queue-arn
COMMERCE_COMMAND_QUEUE_DLQ_URL=/cellifi/dev/inventory/runtime/commerce-command-queue-dlq-url
COMMERCE_COMMAND_QUEUE_DLQ_ARN=/cellifi/dev/inventory/runtime/commerce-command-queue-dlq-arn
FULFILLMENT_COMMAND_QUEUE_URL=/cellifi/dev/inventory/runtime/fulfillment-command-queue-url
FULFILLMENT_COMMAND_QUEUE_ARN=/cellifi/dev/inventory/runtime/fulfillment-command-queue-arn
FULFILLMENT_COMMAND_QUEUE_DLQ_URL=/cellifi/dev/inventory/runtime/fulfillment-command-queue-dlq-url
FULFILLMENT_COMMAND_QUEUE_DLQ_ARN=/cellifi/dev/inventory/runtime/fulfillment-command-queue-dlq-arn
COMMERCE_RESULT_QUEUE_URL=/cellifi/dev/inventory/runtime/commerce-result-queue-url
COMMERCE_RESULT_QUEUE_ARN=/cellifi/dev/inventory/runtime/commerce-result-queue-arn
FULFILLMENT_RESULT_QUEUE_URL=/cellifi/dev/inventory/runtime/fulfillment-result-queue-url
FULFILLMENT_RESULT_QUEUE_ARN=/cellifi/dev/inventory/runtime/fulfillment-result-queue-arn
