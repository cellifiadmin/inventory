generator inventoryClient {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/inventoryClient"
  previewFeatures = ["fullTextSearchPostgres"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource inventoryDb {
  provider     = "postgresql"
  url          = env("INVENTORY_DATABASE_URL")
  relationMode = "foreignKeys"
}

model Blob {
  key         String       @inventoryDb.VarChar(255)
  checksum    String
  assetRef    String?      @unique @map("asset_ref") @inventoryDb.VarChar(512)
  url         String?
  size        Int?
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  name        String
  extension   String       @inventoryDb.VarChar(10)
  fileType    String       @map("file_type")
  id          Int          @id @default(autoincrement())
  attachments Attachment[]

  @@index([key])
  @@map("blobs")
}

model Attachment {
  metadata       Json?
  attachableType String    @map("attachable_type")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  id             Int       @id @default(autoincrement())
  blobId         Int       @map("blob_id")
  attachableId   Int       @map("attachable_id")
  attachmentType String    @map("attachment_type")
  item           Item      @relation("images", fields: [attachableId], references: [id])
  blob           Blob      @relation(fields: [blobId], references: [id])
  mainImageFor   Item[]    @relation("mainImage")

  @@unique([blobId, attachableId, attachableType, attachmentType])
  @@index([blobId, attachableId, attachableType, attachmentType])
  @@map("attachments")
}

model Item {
  id                 Int                 @id @default(autoincrement())
  kind               ItemKind
  itemCode           String              @map("item_code") @inventoryDb.VarChar(255)
  status             String              @default("ACTIVE") @inventoryDb.VarChar(20)
  addressLine1       String?             @map("address_line1") @inventoryDb.VarChar(255)
  addressLine2       String?             @map("address_line2") @inventoryDb.VarChar(255)
  addressCity        String?             @map("address_city") @inventoryDb.VarChar(100)
  addressStateCode   String?             @map("address_state_code") @inventoryDb.VarChar(32)
  addressPostalCode  String?             @map("address_postal_code") @inventoryDb.VarChar(20)
  addressCountryCode String?             @map("address_country_code") @inventoryDb.VarChar(3)
  addressLatitude    Float?              @map("address_latitude")
  addressLongitude   Float?              @map("address_longitude")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")
  mainImageId        Int?                @map("main_image_id")
  sellerIdentifier   String              @default("seller") @map("seller_identifier") @inventoryDb.VarChar(50)
  images             Attachment[]        @relation("images")
  mainImage          Attachment?         @relation("mainImage", fields: [mainImageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  components         Component[]
  movements          Movement[]
  reservations       StockReservation[]
  returnRestockLines ReturnRestockLine[]
  replacementStockHolds ReplacementStockHold[]

  @@unique([sellerIdentifier, itemCode])
  @@index([sellerIdentifier])
  @@index([kind])
  @@index([sellerIdentifier, kind])
  @@map("items")
}

model AccountAddress {
  id                Int       @id @default(autoincrement())
  accountIdentifier String    @map("account_identifier") @inventoryDb.VarChar(50)
  type              String    @inventoryDb.VarChar(32)
  line1             String?   @inventoryDb.VarChar(255)
  line2             String?   @inventoryDb.VarChar(255)
  city              String?   @inventoryDb.VarChar(100)
  stateCode         String?   @map("state_code") @inventoryDb.VarChar(32)
  postalCode        String?   @map("postal_code") @inventoryDb.VarChar(20)
  countryCode       String    @map("country_code") @inventoryDb.VarChar(3)
  latitude          Float?
  longitude         Float?
  label             String?   @inventoryDb.VarChar(50)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@unique([accountIdentifier, type])
  @@index([accountIdentifier])
  @@map("account_addresses")
}

model Component {
  id                Int                @id @default(autoincrement())
  itemId            Int                @map("item_id")
  childType         ComponentChildType @map("child_type")
  instanceId        Int?               @unique @map("instance_id")
  bundleId          Int?               @map("bundle_id")
  componentSnapshot Json?              @map("component_snapshot")
  position          Int?               @map("position")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  item              Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  instance          Instance?          @relation(fields: [instanceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bundle            Bundle?            @relation(fields: [bundleId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([itemId, bundleId])
  @@index([itemId])
  @@index([bundleId])
  @@map("components")
}

model Instance {
  id          Int         @id @default(autoincrement())
  identifier  String      @inventoryDb.VarChar(255)
  sku         String      @inventoryDb.VarChar(50)
  productType ProductType @map("product_type")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  component   Component?

  @@unique([identifier, sku, productType])
  @@index([sku])
  @@map("instances")
}

model Bundle {
  id          Int         @id @default(autoincrement())
  sku         String      @inventoryDb.VarChar(50)
  productType ProductType @map("product_type")
  count       Int         @default(1)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  components  Component[]

  @@unique([sku, productType, count])
  @@index([sku])
  @@map("bundles")
}

model Movement {
  id        Int               @id @default(autoincrement())
  quantity  Int
  createdAt DateTime          @default(now()) @map("created_at")
  itemId    Int               @map("item_id")
  direction MovementDirection
  reason    MovementReason
  metadata  Json?
  createdBy Int?              @map("created_by")
  item      Item              @relation(fields: [itemId], references: [id])

  reservedFor StockReservation?  @relation("ReservationHold")
  releasedFor StockReservation?  @relation("ReservationRelease")
  soldFor     StockReservation?  @relation("ReservationSale")
  returnedFor ReturnRestockLine?
  replacementHeldFor ReplacementStockHold? @relation("ReplacementHold")
  replacementReleasedFor ReplacementStockHold? @relation("ReplacementRelease")
  replacementSoldFor ReplacementStockHold? @relation("ReplacementSale")

  @@unique([id, itemId])
  @@index([itemId, direction])
  @@map("movements")
}

model OffersOffer {
  id                  Int                      @id @default(autoincrement())
  title               String                   @inventoryDb.VarChar(200)
  description         String
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  validFrom           DateTime                 @default(now()) @map("valid_from")
  validTo             DateTime?                @map("valid_to")
  local               Boolean?                 @default(true)
  online              Boolean?                 @default(false)
  slug                String?                  @unique @inventoryDb.VarChar(255)
  deletedAt           DateTime?                @map("deleted_at")
  currentPriceId      Int?                     @unique @map("current_price_id")
  sellerIdentifier    String?                  @map("seller_identifier") @inventoryDb.VarChar(50)
  itemCode            String?                  @map("item_code") @inventoryDb.VarChar(255)
  minOrderUnits       Int                      @default(1) @map("min_order_units")
  status              OfferStatus              @default(INACTIVE)
  version             Int                      @default(0)
  expiredAt           DateTime?                @map("expired_at")
  latestPublicationId Int?                     @unique @map("latest_publication_id")
  addressState        String?                  @map("address_state") @inventoryDb.VarChar(10)
  addressCountry      String?                  @map("address_country") @inventoryDb.VarChar(3)
  currencyCode        String?                  @map("currency_code") @inventoryDb.VarChar(3)
  currencySymbol      String?                  @map("currency_symbol") @inventoryDb.VarChar(10)
  publications        OffersOfferPublication[] @relation("OffersPublications")
  currentPrice        OffersPrice?             @relation("OffersCurrentPrice", fields: [currentPriceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  latestPublication   OffersOfferPublication?  @relation("OffersLatestPublication", fields: [latestPublicationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  prices              OffersPrice[]            @relation("OffersPrices")
  visits              OffersVisit[]            @relation("OffersVisits")

  @@index([sellerIdentifier, itemCode, deletedAt])
  @@index([sellerIdentifier, itemCode, addressCountry, addressState, minOrderUnits])
  @@map("offers")
}

model OffersOfferPublication {
  id             Int                    @id @default(autoincrement())
  offerId        Int                    @map("offer_id")
  version        Int
  action         OfferPublicationAction
  publishedAt    DateTime               @default(now()) @map("published_at")
  offer          OffersOffer            @relation("OffersPublications", fields: [offerId], references: [id])
  latestForOffer OffersOffer?           @relation("OffersLatestPublication")

  @@index([offerId, publishedAt])
  @@index([offerId, version])
  @@map("offer_publications")
}

model OffersVisit {
  id        Int         @id @default(autoincrement())
  offerId   Int         @map("offer_id")
  createdAt DateTime    @default(now()) @map("created_at")
  offer     OffersOffer @relation("OffersVisits", fields: [offerId], references: [id])

  @@index([offerId, createdAt])
  @@map("visits")
}

model OffersPrice {
  id           Int          @id @default(autoincrement())
  offerId      Int          @map("offer_id")
  amount       Decimal      @inventoryDb.Decimal(10, 2)
  createdAt    DateTime     @default(now()) @map("created_at")
  currentOffer OffersOffer? @relation("OffersCurrentPrice")
  offer        OffersOffer  @relation("OffersPrices", fields: [offerId], references: [id])

  @@index([offerId])
  @@map("prices")
}

enum ItemKind {
  STOCK
  LISTING
}

enum OfferPublicationAction {
  LIST
  DELIST
}

enum OfferStatus {
  ACTIVE
  INACTIVE
}

enum ComponentChildType {
  INSTANCE
  BUNDLE
}

enum ProductType {
  PHONE
  WATCH
  TABLET
  ACCESSORY
}

enum MovementDirection {
  IN
  OUT
}

enum MovementReason {
  STOCKED
  SOLD
  TRANSFERRED
  DAMAGED
  ADJUSTMENT
  ADJUSTED
  RESERVED
  RELEASED
  RETURNED
  REPLACEMENT
}

enum ReplacementStockHoldState {
  HELD
  COMMITTED
  RELEASED
}

model ReplacementStockHold {
  id                     String @id @default(uuid())
  operationId            String @unique @map("operation_id")
  shipmentId             String @unique @map("shipment_id")
  entitlementId          String @map("entitlement_id")
  sellerOrderId          String @map("seller_order_id")
  sellerAccountId        String @map("seller_account_id")
  purchaseId             String @map("purchase_id")
  commerceSellerOrderId  String @map("commerce_seller_order_id")
  commercePurchaseLineId String @map("commerce_purchase_line_id")
  itemId                 Int @map("item_id")
  quantity               Int
  inputHash              String @map("input_hash") @inventoryDb.VarChar(64)
  state                  ReplacementStockHoldState @default(HELD)
  saleIdentity           Json @map("sale_identity")
  heldMovementId         Int @unique @map("held_movement_id")
  releasedMovementId     Int? @unique @map("released_movement_id")
  soldMovementId         Int? @unique @map("sold_movement_id")
  createdAt              DateTime @default(now()) @map("created_at") @inventoryDb.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @inventoryDb.Timestamptz(3)
  command                InventoryCommand @relation(fields: [operationId], references: [operationId], onDelete: Restrict, onUpdate: Restrict)
  item                   Item @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  heldMovement           Movement @relation("ReplacementHold", fields: [heldMovementId, itemId], references: [id, itemId], onDelete: Restrict, onUpdate: Restrict)
  releasedMovement       Movement? @relation("ReplacementRelease", fields: [releasedMovementId, itemId], references: [id, itemId], onDelete: Restrict, onUpdate: Restrict)
  soldMovement           Movement? @relation("ReplacementSale", fields: [soldMovementId, itemId], references: [id, itemId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([heldMovementId, itemId])
  @@unique([releasedMovementId, itemId])
  @@unique([soldMovementId, itemId])
  @@index([sellerOrderId])
  @@index([itemId, state])
  @@map("replacement_stock_holds")
}

model ReturnRestockOperation {
  operationId     String              @id @map("operation_id") @inventoryDb.VarChar(160)
  returnId        String              @unique @map("return_id") @inventoryDb.VarChar(191)
  sellerOrderId   String              @map("seller_order_id") @inventoryDb.VarChar(191)
  sellerAccountId String              @map("seller_account_id") @inventoryDb.VarChar(191)
  evidenceHash    String              @map("evidence_hash") @inventoryDb.VarChar(64)
  inputHash       String              @map("input_hash") @inventoryDb.VarChar(64)
  input           Json
  result          Json
  createdAt       DateTime            @default(now()) @map("created_at") @inventoryDb.Timestamptz(3)
  lines           ReturnRestockLine[]

  @@index([sellerOrderId])
  @@map("return_restock_operations")
}

model ReturnRestockLine {
  id                     String                 @id @default(uuid())
  operationId            String                 @map("operation_id") @inventoryDb.VarChar(160)
  itemId                 Int                    @map("item_id")
  movementId             Int                    @unique @map("movement_id")
  commercePurchaseLineId String                 @map("commerce_purchase_line_id") @inventoryDb.VarChar(191)
  quantity               Int
  operation              ReturnRestockOperation @relation(fields: [operationId], references: [operationId], onDelete: Restrict, onUpdate: Restrict)
  item                   Item                   @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  movement               Movement               @relation(fields: [movementId, itemId], references: [id, itemId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([operationId, commercePurchaseLineId])
  @@unique([movementId, itemId])
  @@index([itemId])
  @@map("return_restock_lines")
}

enum ReservationState {
  HELD
  PAYMENT_LOCKED
  COMMITTED
  RELEASED
  EXPIRED
}

enum ReservationOperationKind {
  RESERVE
  PROTECT
  COMMIT
  RELEASE
  EXPIRE
}

model StockReservation {
  id                    String                    @id @default(uuid())
  scopeLineId           String                    @unique @map("scope_line_id")
  checkoutId            String                    @map("checkout_id")
  checkoutVersion       Int                       @map("checkout_version")
  lineId                String                    @map("line_id")
  itemId                Int                       @map("item_id")
  state                 ReservationState          @default(HELD)
  revision              Int                       @default(0)
  expiresAt             DateTime                  @map("expires_at") @inventoryDb.Timestamptz(3)
  paymentScopeId        String?                   @map("payment_scope_id")
  fence                 Int                       @default(0)
  paymentId             String?                   @map("payment_id")
  purchaseId            String?                   @map("purchase_id")
  commerceSellerOrderId String?                   @map("commerce_seller_order_id")
  resolutionId          String?                   @map("resolution_id")
  scopeClosedAt         DateTime?                 @map("scope_closed_at") @inventoryDb.Timestamptz(3)
  releaseCause          String?                   @map("release_cause")
  heldMovementId        Int                       @unique @map("held_movement_id")
  releasedMovementId    Int?                      @unique @map("released_movement_id")
  soldMovementId        Int?                      @unique @map("sold_movement_id")
  createdAt             DateTime                  @default(now()) @map("created_at") @inventoryDb.Timestamptz(3)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @inventoryDb.Timestamptz(3)
  scopeLine             InventoryReserveScopeLine @relation(fields: [scopeLineId, checkoutId, checkoutVersion, lineId], references: [id, checkoutId, checkoutVersion, lineId], onDelete: Restrict, onUpdate: Restrict)
  item                  Item                      @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  heldMovement          Movement                  @relation("ReservationHold", fields: [heldMovementId, itemId], references: [id, itemId], onDelete: Restrict, onUpdate: Restrict)
  releasedMovement      Movement?                 @relation("ReservationRelease", fields: [releasedMovementId, itemId], references: [id, itemId], onDelete: Restrict, onUpdate: Restrict)
  soldMovement          Movement?                 @relation("ReservationSale", fields: [soldMovementId, itemId], references: [id, itemId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([scopeLineId, checkoutId, checkoutVersion, lineId])
  @@unique([heldMovementId, itemId])
  @@unique([releasedMovementId, itemId])
  @@unique([soldMovementId, itemId])
  @@unique([checkoutId, checkoutVersion, lineId])
  @@index([itemId])
  @@index([state, expiresAt, id])
  @@index([paymentScopeId, state])
  @@map("stock_reservations")
}

model ReservationOperation {
  id               String                   @id
  kind             ReservationOperationKind
  checkoutId       String                   @map("checkout_id")
  checkoutVersion  Int                      @map("checkout_version")
  inputFingerprint String                   @map("input_fingerprint")
  input            Json
  result           Json
  createdAt        DateTime                 @default(now()) @map("created_at") @inventoryDb.Timestamptz(3)

  @@index([checkoutId, checkoutVersion])
  @@map("reservation_operations")
}

enum InventoryCommandProducer {
  commerce
  fulfillment
}

enum InventoryCommandState {
  RECEIVED
  SUCCEEDED
  FAILED
  RECONCILING
}

enum InventoryResultDeliveryState {
  PENDING
  SENDING
  DELIVERED
  EXHAUSTED
}

model InventoryCommand {
  operationId        String                            @id @map("operation_id")
  producer           InventoryCommandProducer
  command            String
  executionId        String                            @map("execution_id")
  correlationId      String                            @map("correlation_id")
  resourceType       String                            @map("resource_type")
  resourceId         String                            @map("resource_id")
  resourceVersion    Int                               @map("resource_version")
  operationInputHash String                            @map("operation_input_hash")
  envelopeHash       String                            @map("envelope_hash")
  immutableEnvelope  Json                              @map("immutable_envelope")
  state              InventoryCommandState             @default(RECEIVED)
  result             Json?
  receivedAt         DateTime                          @default(now()) @map("received_at") @inventoryDb.Timestamptz(3)
  completedAt        DateTime?                         @map("completed_at") @inventoryDb.Timestamptz(3)
  inboxEvents        InventoryInboxEvent[]
  resultOutbox       InventoryResultOutbox[]
  recoveries         InventoryCommandRecovery[]
  reserveClosures    InventoryReserveNoEffectClosure[]
  replacementHold    ReplacementStockHold?

  @@index([resourceType, resourceId, resourceVersion])
  @@index([state, receivedAt])
  @@map("inventory_commands")
}

model InventoryInboxEvent {
  id          String                   @id @default(uuid())
  producer    InventoryCommandProducer
  eventId     String                   @map("event_id")
  operationId String                   @map("operation_id")
  payloadHash String                   @map("payload_hash")
  payload     Json
  receivedAt  DateTime                 @default(now()) @map("received_at") @inventoryDb.Timestamptz(3)
  command     InventoryCommand         @relation(fields: [operationId], references: [operationId], onDelete: Restrict, onUpdate: Restrict)

  resultDelivery InventoryResultOutbox?

  @@unique([producer, eventId])
  @@index([operationId])
  @@map("inventory_inbox_events")
}

model InventoryResultOutbox {
  id             String                       @id @default(uuid())
  operationId    String                       @map("operation_id")
  eventId        String                       @map("event_id")
  receiptId      String                       @unique @map("receipt_id")
  destination    InventoryCommandProducer
  payload        Json
  payloadHash    String                       @map("payload_hash")
  state          InventoryResultDeliveryState @default(PENDING)
  attempts       Int                          @default(0)
  nextAttemptAt  DateTime                     @default(now()) @map("next_attempt_at") @inventoryDb.Timestamptz(3)
  leaseOwner     String?                      @map("lease_owner")
  leaseExpiresAt DateTime?                    @map("lease_expires_at") @inventoryDb.Timestamptz(3)
  fencingToken   Int                          @default(0) @map("fencing_token")
  lastErrorCode  String?                      @map("last_error_code")
  createdAt      DateTime                     @default(now()) @map("created_at") @inventoryDb.Timestamptz(3)
  deliveredAt    DateTime?                    @map("delivered_at") @inventoryDb.Timestamptz(3)
  command        InventoryCommand             @relation(fields: [operationId], references: [operationId], onDelete: Restrict, onUpdate: Restrict)

  receipt InventoryInboxEvent @relation(fields: [receiptId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([operationId])
  @@index([eventId])
  @@index([state, nextAttemptAt, id])
  @@index([state, leaseExpiresAt, id])
  @@map("inventory_result_outbox")
}

enum InventoryRecoverySeverity {
  HIGH
  CRITICAL
}

enum InventoryRecoveryAction {
  INSPECT_PAYMENT_AND_RESERVATION
  REDELIVER_ORIGINAL_RESULT
  REDELIVER_OWNER_EVENT
}

model InventoryCommandRecovery {
  id            String                    @id @default(uuid())
  operationId   String                    @map("operation_id")
  reason        String
  assignedOwner String                    @map("assigned_owner")
  severity      InventoryRecoverySeverity
  nextAction    InventoryRecoveryAction   @map("next_action")
  dueAt         DateTime                  @map("due_at") @inventoryDb.Timestamptz(3)
  createdAt     DateTime                  @default(now()) @map("created_at") @inventoryDb.Timestamptz(3)
  resolvedAt    DateTime?                 @map("resolved_at") @inventoryDb.Timestamptz(3)
  command       InventoryCommand          @relation(fields: [operationId], references: [operationId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([operationId, reason])
  @@index([resolvedAt, dueAt])
  @@map("inventory_command_recoveries")
}

enum InventoryReserveScopeState {
  CLAIMED
  RESERVED
  CLOSED_NO_EFFECT
}

enum InventoryReserveClosureReason {
  RESERVE_REJECTED
  RESERVE_DEADLINE_EXPIRED
  RESERVE_EXPIRED
  CANCELLED
}

model InventoryReserveScope {
  id                        String                           @id @default(uuid())
  checkoutId                String                           @map("checkout_id")
  checkoutVersion           Int                              @map("checkout_version")
  reserveOperationId        String                           @unique @map("reserve_operation_id")
  reserveOperationInputHash String                           @map("reserve_operation_input_hash")
  reserveInputHash          String                           @map("reserve_input_hash")
  originalDescriptorHash    String                           @map("original_descriptor_hash")
  originalDescriptor        Json                             @map("original_descriptor")
  expiresAt                 DateTime                         @map("expires_at") @inventoryDb.Timestamptz(3)
  state                     InventoryReserveScopeState       @default(CLAIMED)
  revision                  Int                              @default(0)
  protectedRevision         Int?                             @map("protected_revision")
  createdAt                 DateTime                         @default(now()) @map("created_at") @inventoryDb.Timestamptz(3)
  updatedAt                 DateTime                         @updatedAt @map("updated_at") @inventoryDb.Timestamptz(3)
  lines                     InventoryReserveScopeLine[]
  noEffectClosure           InventoryReserveNoEffectClosure?
  ownerEvents               InventoryOwnerEvent[]

  @@unique([checkoutId, checkoutVersion])
  @@unique([id, checkoutId, checkoutVersion])
  @@index([state, createdAt])
  @@map("inventory_reserve_scopes")
}

model InventoryReserveScopeLine {
  id              String                @id @default(uuid())
  scopeId         String                @map("scope_id")
  checkoutId      String                @map("checkout_id")
  checkoutVersion Int                   @map("checkout_version")
  lineId          String                @map("line_id")
  accountId       String                @map("account_id")
  sourceInvId     String                @map("source_inv_id")
  quantity        Int
  scope           InventoryReserveScope @relation(fields: [scopeId, checkoutId, checkoutVersion], references: [id, checkoutId, checkoutVersion], onDelete: Restrict, onUpdate: Restrict)
  reservation     StockReservation?

  @@unique([scopeId, lineId])
  @@unique([id, checkoutId, checkoutVersion, lineId])
  @@index([checkoutId, checkoutVersion])
  @@map("inventory_reserve_scope_lines")
}

model InventoryReserveNoEffectClosure {
  id                     String                        @id @default(uuid())
  scopeId                String                        @unique @map("scope_id")
  authorizingOperationId String                        @map("authorizing_operation_id")
  reason                 InventoryReserveClosureReason
  closedAt               DateTime                      @map("closed_at") @inventoryDb.Timestamptz(3)
  evidenceHash           String                        @map("evidence_hash")
  scope                  InventoryReserveScope         @relation(fields: [scopeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  command                InventoryCommand              @relation(fields: [authorizingOperationId], references: [operationId], onDelete: Restrict, onUpdate: Restrict)

  @@index([authorizingOperationId])
  @@map("inventory_reserve_no_effect_closures")
}

enum InventoryOwnerEventKind {
  INVENTORY_RESERVATION_COMMITTED
  INVENTORY_RESERVATION_RELEASED
  INVENTORY_RESERVATION_EXPIRED
}

model InventoryOwnerEvent {
  id              String                        @id @inventoryDb.VarChar(191)
  scopeId         String                        @map("scope_id")
  scopeRevision   Int                           @map("scope_revision")
  checkoutId      String                        @map("checkout_id")
  checkoutVersion Int                           @map("checkout_version")
  kind            InventoryOwnerEventKind
  observedAt      DateTime                      @map("observed_at") @inventoryDb.Timestamptz(3)
  payload         Json
  payloadHash     String                        @map("payload_hash") @inventoryDb.VarChar(64)
  createdAt       DateTime                      @default(now()) @map("created_at") @inventoryDb.Timestamptz(3)
  scope           InventoryReserveScope         @relation(fields: [scopeId, checkoutId, checkoutVersion], references: [id, checkoutId, checkoutVersion], onDelete: Restrict, onUpdate: Restrict)
  delivery        InventoryOwnerEventOutbox?
  recoveries      InventoryOwnerEventRecovery[]

  @@unique([scopeId, scopeRevision])
  @@index([checkoutId, checkoutVersion])
  @@map("inventory_owner_events")
}

model InventoryOwnerEventOutbox {
  id             String                       @id @default(uuid())
  eventId        String                       @unique @map("event_id") @inventoryDb.VarChar(191)
  state          InventoryResultDeliveryState @default(PENDING)
  attempts       Int                          @default(0)
  nextAttemptAt  DateTime                     @default(now()) @map("next_attempt_at") @inventoryDb.Timestamptz(3)
  leaseOwner     String?                      @map("lease_owner")
  leaseExpiresAt DateTime?                    @map("lease_expires_at") @inventoryDb.Timestamptz(3)
  fencingToken   Int                          @default(0) @map("fencing_token")
  lastErrorCode  String?                      @map("last_error_code")
  createdAt      DateTime                     @default(now()) @map("created_at") @inventoryDb.Timestamptz(3)
  deliveredAt    DateTime?                    @map("delivered_at") @inventoryDb.Timestamptz(3)
  event          InventoryOwnerEvent          @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([state, nextAttemptAt, id])
  @@index([state, leaseExpiresAt, id])
  @@map("inventory_owner_event_outbox")
}

model InventoryOwnerEventRecovery {
  id            String                    @id @default(uuid())
  eventId       String                    @map("event_id") @inventoryDb.VarChar(191)
  reason        String
  assignedOwner String                    @map("assigned_owner")
  severity      InventoryRecoverySeverity
  nextAction    InventoryRecoveryAction   @map("next_action")
  dueAt         DateTime                  @map("due_at") @inventoryDb.Timestamptz(3)
  createdAt     DateTime                  @default(now()) @map("created_at") @inventoryDb.Timestamptz(3)
  resolvedAt    DateTime?                 @map("resolved_at") @inventoryDb.Timestamptz(3)
  event         InventoryOwnerEvent       @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([eventId, reason])
  @@index([resolvedAt, dueAt])
  @@map("inventory_owner_event_recoveries")
}
